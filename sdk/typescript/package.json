{
  "name": "sbx-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Warmbox (sbxd): run LLM-generated code in warm-pool sandboxes. E2B-shaped API, zero runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "sandbox",
    "code-interpreter",
    "llm",
    "agents",
    "podman",
    "e2b",
    "pty"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --exclude 'test/live/**'",
    "test:live": "vitest run test/live",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^20.19.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
